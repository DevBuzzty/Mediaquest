# Vorlage für die .env. Für die lokale Entwicklung ist keine .env nötig.

# Pflicht im Betrieb (NODE_ENV=production): mindestens 32 zufällige Zeichen.
# Erzeugen z. B. mit: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
PORT=3000
# HOST=127.0.0.1
# NODE_ENV=production

# Datenverzeichnis für SQLite und Uploads (Standard: <Projekt>/data)
# DATA_DIR=/var/lib/weltenretter

# Hinter dem Reverse-Proxy (Standard im Betrieb: 1 Hop), Cookies nur per HTTPS (Standard im Betrieb: true)
# TRUST_PROXY=1
# COOKIE_SECURE=true

# Selbst-Registrierung (Standard: im Betrieb aus, sonst an)
# ALLOW_REGISTRATION=false

# Demo-Konten mit bekannten Passwörtern, nur für die Entwicklung (Standard: im Betrieb aus, sonst an).
# Auf einem erreichbaren Server nie einschalten.
# SEED_DEMO=false

# Abgeschlossene Sessions samt Fotos automatisch löschen (Tage, 0 = nie; Standard im Betrieb: 90)
# SESSION_RETENTION_DAYS=90

# Gültigkeit einer Anmeldung in Stunden (Standard: 12), Kostenfaktor für bcrypt (Standard: 12)
# SESSION_MAX_AGE_HOURS=12
# BCRYPT_ROUNDS=12

# Log-Ausgabe: silent, error, warn, info, debug (Standard: info)
# LOG_LEVEL=info

# E-Mail für Login-Codes
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
