{
  "name": "weltenretter-app",
  "version": "1.0.0",
  "description": "Digitale Begleit-App für das hybride Brettspiel Weltenretter-Forschungsteam",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "build:css": "tailwindcss -c tailwind.config.js -i styles/tailwind.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i styles/tailwind.css -o public/css/app.css --watch",
    "vendor": "node scripts/vendor.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.18.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.4.0",
    "socket.io": "^4.7.5",
    "sqlite3": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "html5-qrcode": "2.3.8",
    "nodemon": "^3.1.0",
    "qrcode": "1.5.4",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "3.4.19"
  },
  "engines": {
    "node": ">=22"
  }
}
